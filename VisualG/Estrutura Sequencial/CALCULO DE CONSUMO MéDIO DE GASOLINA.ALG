Algoritmo "Calculo de consumo médio de gasolina"

Var
   distancia, combustivel, consumo : real


Inicio

escreva("a distância percorrida é de: ")
leia(distancia)

escreva("Quantos Litros de combustivel foram gastos? ")
leia(combustivel)

consumo <- distancia/combustivel

escreval("Consumo médio de combustivel é de: ",consumo:5:2," Litros")


Fimalgoritmo