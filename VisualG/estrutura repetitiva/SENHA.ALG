Algoritmo "senha"
// Escreva um programa que repita a leitura de uma senha até  que seja válida
Var
senha : inteiro


Inicio

      escreva("Digite a senha: ")
      leia(senha)
      
      enquanto senha <> 2002 faca
               escreva("Senha invalida tente novamente! ")
               leia (senha)
      fimenquanto
      escreval("Senha correta")


Fimalgoritmo